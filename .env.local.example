# ── Database (Neon) ───────────────────────────────────────────────
# Populate the two URLs below with:  npx neon env pull
# That writes DATABASE_URL and DATABASE_URL_UNPOOLED into .env.local.

# Pooled connection (note the "-pooler" host) — used by the app at runtime.
# Always use the pooled host on serverless; each request gets its own connection.
DATABASE_URL=postgresql://[user]:[password]@ep-[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require

# Direct/unpooled connection (same host, without "-pooler").
# Used by the Prisma CLI for migrations (see prisma.config.ts), and required by
# pg_dump / pg_restore — neither supports pooled connections.
DATABASE_URL_UNPOOLED=postgresql://[user]:[password]@ep-[endpoint].[region].aws.neon.tech/neondb?sslmode=require

# ── Steam ─────────────────────────────────────────────────────────
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ── NextAuth ──────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000
